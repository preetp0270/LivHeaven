<% layout('/layouts/boilerplate') -%>

<div class="container py-5 text-center" style="max-width: 520px;">
  <div class="card border-0 p-4" style="box-shadow: var(--shadow-soft);">
    <div class="page-kicker mb-2">Something went wrong</div>
    <h1 class="page-title" style="font-size: 1.75rem;">Error <%= status || 500 %></h1>
    <p class="text-muted mb-4"><%= message || 'An unexpected error occurred.' %></p>
    <a href="/listing" class="btn btn-primary px-4">Back to explore</a>
  </div>
</div>
