    <div class="collapse navbar-collapse justify-content-center order-lg-1" id="navbarCollapse">
      <ul class="navbar-nav mx-auto align-items-lg-center">
        <li class="nav-item me-lg-3">
          <a href="/listing" class="nav-link">Explore</a>
        </li>
        <li class="nav-item w-100">
          <div class="country-search-container mt-2 mt-lg-0">
            <input type="text" id="country-input" class="form-control border-0 shadow-none px-0"
              placeholder="Where do you want to go?" />
            <button type="button" class="btn" id="nav-btn">
              Search <i class="fa-solid fa-magnifying-glass ms-1"></i>
            </button>
          </div>
        </li>
      </ul>
      <% if (!currentUser) { %>
        <div class="d-flex d-md-none gap-2 mt-3 justify-content-center">
          <a href="/signup" class="btn btn-outline-primary btn-sm">Sign Up</a>
          <a href="/login" class="btn btn-primary btn-sm">Log In</a>
        </div>
      <% } %>
    </div>

  </div>
