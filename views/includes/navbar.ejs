<nav class="navbar navbar-expand-lg fixed-top glass-navbar" data-bs-theme="light">
  <div class="container-fluid px-3 px-lg-4">

    <a class="navbar-brand me-2" href="/listing">
      <span class="brand-mark material-symbols-outlined">home</span>
      <span>
        LivHeaven
        <span class="brand-sub d-none d-sm-block">Private estates</span>
      </span>
    </a>

    <div class="d-flex align-items-center order-lg-3 gap-1">
      <% if (!currentUser) { %>
        <a href="/signup" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">Sign Up</a>
        <a href="/login" class="btn btn-primary btn-sm d-none d-md-inline-block">Log In</a>
      <% } else { %>
        <form action="/listing/new" method="GET" class="add-listing-form d-inline me-1">
          <button type="submit" class="btn btn-add-listing">
            <i class="fa-solid fa-plus"></i>
            <span class="d-none d-md-inline">LivHeaven your home</span>
          </button>
        </form>
        <div class="dropdown d-none d-md-block">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center"
            id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-user me-1"></i>
            <span class="d-none d-lg-inline"><%= currentUser.username %></span>
          </button>
          <div class="dropdown-menu dropdown-menu-end p-0 shadow-sm" aria-labelledby="userDropdown">
            <%- include('../includes/userCard.ejs') %>
          </div>
        </div>
        <a href="/logout" class="btn btn-sm btn-outline-secondary d-md-none ms-1">Logout</a>
      <% } %>
    </div>

    <button class="navbar-toggler order-lg-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
      aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
