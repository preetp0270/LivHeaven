<% layout('/layouts/boilerplate') -%>

<div class="auth-shell">
  <div class="auth-panel">

    <div class="auth-visual" style="background-image: url('https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=1400&q=85');">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <span class="pill-tag">
          <span style="width:7px;height:7px;border-radius:50%;background:#fc9174;display:inline-block;"></span>
          Join the guild
        </span>
        <span class="pill-tag">
          <i class="fa-solid fa-leaf"></i> Conscious travel
        </span>
      </div>

      <div>
        <p class="text-white-50 small text-uppercase mb-2" style="letter-spacing:0.1em;font-weight:600;">Begin your journey</p>
        <h2 class="text-white serif mb-3" style="font-size:clamp(1.6rem,2.5vw,2.2rem);line-height:1.25;">
          Host or stay in homes designed for stillness.
        </h2>
        <div class="editorial-quote">
          <div class="quote-label">For hosts & guests</div>
          <p>“Create an account to list your sanctuary or book stays of architectural reverence.”</p>
        </div>
      </div>
    </div>

    <div class="auth-form-side">
      <div class="d-flex align-items-center gap-2 mb-3">
        <span class="brand-mark material-symbols-outlined" style="width:36px;height:36px;border-radius:8px;background:var(--primary);color:#fff;display:inline-flex;align-items:center;justify-content:center;">home</span>
        <div>
          <div class="fw-semibold" style="color:var(--primary-dark);">LivHeaven</div>
          <div class="small text-muted" style="font-size:0.7rem;letter-spacing:0.04em;text-transform:uppercase;">Private architectural estates</div>
        </div>
      </div>

      <div class="auth-tabs">
        <a href="/login">Log In</a>
        <a href="/signup" class="active">Sign Up</a>
      </div>

      <h1 class="auth-headline">Create your account</h1>
      <p class="auth-sub">Join LivHeaven to host or discover curated stays.</p>

      <form action="/signup" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control" id="username" name="username" placeholder="Choose a username" required autocomplete="username">
          <div class="invalid-feedback">Please enter a username.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
          <div class="invalid-feedback">Please enter a valid email.</div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="Create a password" required autocomplete="new-password">
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 mt-2">
          Create account <i class="fa-solid fa-arrow-right ms-1"></i>
        </button>
      </form>

      <p class="text-center small text-muted mt-4 mb-0">
        Already have an account?
        <a href="/login" style="color:var(--secondary-strong);font-weight:600;">Log in</a>
      </p>
    </div>

  </div>
</div>
