<% layout('/layouts/boilerplate') -%>
<script>
  const mapToken = '<%= process.env.MAP_TOKEN %>';
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const locationName = '<%= listing.location %>';
</script>

<div class="container py-4" style="max-width: 920px;">

  <% if (listing.image && listing.image.url) { %>
    <img src="<%= listing.image.url %>"
         class="show-hero-img"
         alt="<%= listing.title %>">
  <% } %>

  <div class="mb-2">
    <% if (listing.category) { %>
      <span class="page-kicker"><%= listing.category %></span>
    <% } %>
    <h1 class="page-title mb-2"><%= listing.title %></h1>
    <p class="text-muted mb-3">
      <i class="fa-solid fa-location-dot me-1"></i>
      <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
    </p>
  </div>

  <div class="card border-0 mb-4" style="box-shadow: var(--shadow-card);">
    <div class="card-body p-4">
      <% if (listing.description) { %>
        <p class="mb-4" style="font-size: 1.05rem; line-height: 1.65; color: var(--text-subtle);">
          <%= listing.description %>
        </p>
      <% } %>

      <ul class="show-meta-list">
        <li>
          <span>Price</span>
          <strong>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '—' %> <span class="fw-normal text-muted">/ night</span></strong>
        </li>
        <li>
          <span>Host</span>
          <strong><%= listing.owner ? listing.owner.username : 'Unknown' %></strong>
        </li>
        <% if (listing.createdAt) { %>
          <li>
            <span>Listed</span>
            <strong><%= listing.createdAt.toLocaleDateString("en-IN", { year: 'numeric', month: 'short', day: 'numeric' }) %></strong>
          </li>
        <% } %>
      </ul>

      <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <a href="/listing/<%= listing._id %>/edit" class="btn btn-outline-primary px-4">
            <i class="fa-regular fa-pen-to-square me-1"></i> Edit
          </a>
          <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger px-4">
              <i class="fa-regular fa-trash-can me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Reviews -->
  <div class="mb-4">
    <h3 class="serif mb-3" style="font-size: 1.35rem;">Reviews</h3>

    <% if (currentUser) { %>
      <div class="card border-0 mb-4" style="box-shadow: var(--shadow-card);">
        <div class="card-body p-4">
          <h5 class="mb-3" style="font-size: 1rem; font-weight: 600;">Leave a review</h5>
          <form action="/listing/<%= listing._id %>/reviews" method="POST">
            <div class="mb-3">
              <fieldset class="starability-slot">
                <legend class="visually-hidden">Your rating</legend>
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <textarea class="form-control mb-3" name="review[comment]" rows="3" placeholder="Share your experience..." required></textarea>
            <button type="submit" class="btn btn-primary btn-sm px-4">Submit review</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="row g-3">
      <% if (listing.reviews && listing.reviews.length > 0) { %>
        <% listing.reviews.forEach(review => { %>
          <div class="col-md-6">
            <div class="review-card">
              <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                Rated: <%= review.rating %> star<% if (review.rating > 1) { %>s<% } %>
              </p>
              <p class="mb-1 fw-semibold" style="font-size: 0.92rem;">
                <%= review.author && review.author.username ? review.author.username : 'Guest' %>
              </p>
              <p class="text-muted mb-2" style="font-size: 0.9rem;"><%= review.comment %></p>
              <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                <form action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                  <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <p class="text-muted">No reviews yet. Be the first to share your stay.</p>
        </div>
      <% } %>
    </div>
  </div>

  <div class="mb-4">
    <h3 class="serif mb-3" style="font-size: 1.35rem;">Location</h3>
    <div id="map"></div>
  </div>

</div>
<script src="/JavaScript/map.js"></script>
