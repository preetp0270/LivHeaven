<% layout('/layouts/boilerplate') -%>

<div class="container py-4">
  <div class="form-shell">

    <div class="mb-4">
      <div class="page-kicker">Update sanctuary</div>
      <h1 class="page-title">Edit listing</h1>
      <p class="page-lead">Refine the details of your estate. Leave image fields empty to keep the current photo.</p>
    </div>

    <form action="/listing/<%= listing._id %>?_method=PUT" method="post" class="needs-validation" novalidate enctype="multipart/form-data">

      <section class="form-section">
        <div class="form-section-header">
          <div>
            <div class="form-section-label">Section A</div>
            <h2 class="form-section-title">Identity & narrative</h2>
          </div>
          <i class="fa-regular fa-pen-to-square text-muted"></i>
        </div>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input type="text" class="form-control" id="title" name="listing[title]" value="<%= listing.title %>" required>
          <div class="invalid-feedback">Please enter a title.</div>
        </div>
        <div>
          <label for="description" class="form-label">Description</label>
          <textarea class="form-control" id="description" name="listing[description]" rows="4" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>
      </section>

      <section class="form-section">
        <div class="form-section-header">
          <div>
            <div class="form-section-label">Section B</div>
            <h2 class="form-section-title">Imagery</h2>
          </div>
          <i class="fa-regular fa-image text-muted"></i>
        </div>
        <% if (typeof originalImageUrl !== 'undefined' && originalImageUrl) { %>
          <div class="mb-3">
            <label class="form-label">Current image</label>
            <img src="<%= originalImageUrl %>" alt="Current listing" class="img-fluid rounded-3" style="max-height: 240px; object-fit: cover; border: 1px solid var(--border);">
          </div>
        <% } %>
        <p class="small text-muted mb-3">Replace with a new file <strong>or</strong> paste any image URL (uploaded to Cloudinary when possible). Leave both empty to keep the current image.</p>
        <div class="row g-3">
          <div class="col-md-6">
            <label for="image" class="form-label">Upload new file</label>
            <input type="file" class="form-control" id="image" name="listing[image]" accept="image/*">
          </div>
          <div class="col-md-6">
            <label for="imageUrl" class="form-label">Or paste image URL</label>
            <input type="url" class="form-control" id="imageUrl" name="listing[imageUrl]" placeholder="https://example.com/photo.jpg">
          </div>
        </div>
      </section>

      <section class="form-section">
        <div class="form-section-header">
          <div>
            <div class="form-section-label">Section C</div>
            <h2 class="form-section-title">Location & tariff</h2>
          </div>
          <i class="fa-solid fa-location-dot text-muted"></i>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label for="location" class="form-label">City / location</label>
            <input type="text" class="form-control" id="location" name="listing[location]" value="<%= listing.location %>" required>
            <div class="invalid-feedback">Please enter location.</div>
          </div>
          <div class="col-md-6">
            <label for="country" class="form-label">Country</label>
            <input type="text" class="form-control" id="country" name="listing[country]" value="<%= listing.country %>" required>
            <div class="invalid-feedback">Please enter country.</div>
          </div>
          <div class="col-md-6">
            <label for="price" class="form-label">Price per night (₹)</label>
            <input type="number" class="form-control" id="price" name="listing[price]" value="<%= listing.price %>" required min="0">
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>
        </div>
      </section>

      <div class="d-flex flex-wrap gap-2 justify-content-end mt-2 mb-4">
        <a href="/listing/<%= listing._id %>" class="btn btn-outline-secondary px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
          Save changes <i class="fa-solid fa-check ms-1"></i>
        </button>
      </div>

    </form>
  </div>
</div>
